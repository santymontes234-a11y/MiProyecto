# Copia este archivo a .env y reemplaza TODOS los valores. Nunca subas .env al repositorio.

# --- Base de datos ---
POSTGRES_DB=ecomove
POSTGRES_USER=ecomove
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- API ---
API_ENV=development
# Genera con: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-generate-a-long-random-secret
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
# API_PUBLISH_HOST=0.0.0.0           # solo para probar con un teléfono físico en la LAN (la db sigue en 127.0.0.1)
# OSRM_FOOT_URL / OSRM_BICYCLE_URL / OSRM_CAR_URL: por defecto los servicios del perfil "routing"
# Opcionales (valores por defecto entre paréntesis; detalle en apps/api/README.md)
# ENABLE_DOCS=true                    # Swagger en /api/v1/docs; false en producción
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_AUTH_PER_MINUTE=10
# RATE_LIMIT_DEFAULT_PER_MINUTE=120
# LOGIN_MAX_FAILURES=5
# LOGIN_LOCKOUT_MINUTES=15
# ROUTE_TOKEN_SECRET=                 # obligatorio en producción (≥ 32 caracteres); firma de /routes
# REQUIRE_EMAIL_VERIFICATION=false
# EMAIL_BACKEND=smtp                  # smtp | disabled (memory solo en tests)
# SMTP_HOST=localhost
# SMTP_PORT=1025
# WEB_URL=http://localhost:3000       # enlaces de los correos de reset y verificación
# GEOCODING_ENABLED=true              # /geocode: POIs y zonas propias + Nominatim (OSM) acotado a Querétaro
# NOMINATIM_URL=https://nominatim.openstreetmap.org

# Usuario SUPER_ADMIN inicial (solo se crea si no existe ninguno; contraseña ≥ 12 caracteres)
BOOTSTRAP_SUPER_ADMIN_EMAIL=
BOOTSTRAP_SUPER_ADMIN_PASSWORD=

# --- Clientes ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000/api/v1
