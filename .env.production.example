# EcoMove Querétaro — variables de PRODUCCIÓN (plantilla).
#   Genera el archivo real con:  infrastructure/scripts/generate_secrets.sh
#   (crea .env.production con secretos aleatorios y permisos 600). NUNCA lo subas a Git.
# Reemplaza "example.com" por tu dominio real. Detalle de cada variable: docs/deployment/ENVIRONMENT_VARIABLES.md

# --- Dominios (los usan Nginx, la web y la API) ---
DOMAIN=example.com
API_DOMAIN=api.example.com

# --- Imágenes ---
# Etiqueta de las imágenes ecomove/api y ecomove/web. deploy.sh la fija al commit desplegado.
IMAGE_TAG=latest

# --- Base de datos ---
POSTGRES_DB=ecomove
# Rol de la aplicación (NO superusuario). Lo usan la API y las migraciones.
POSTGRES_USER=ecomove_app
POSTGRES_PASSWORD=change-me
# Superusuario de PostgreSQL: solo mantenimiento y backups. La API nunca lo recibe.
POSTGRES_ADMIN_USER=ecomove_admin
POSTGRES_ADMIN_PASSWORD=change-me
# Ajuste de memoria (VPS de 4 GB). Para 2 GB: 128MB / 512MB.
PG_SHARED_BUFFERS=256MB
PG_EFFECTIVE_CACHE_SIZE=768MB

# --- API ---
API_ENV=production
ENABLE_DOCS=false
LOG_LEVEL=INFO
JWT_SECRET_KEY=change-me
ROUTE_TOKEN_SECRET=change-me
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30
# Orígenes del navegador permitidos (solo el sitio web; la app Android no usa CORS).
CORS_ORIGINS=https://example.com,https://www.example.com
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_DEFAULT_PER_MINUTE=120
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
REQUIRE_EMAIL_VERIFICATION=false

# --- Correo (recuperación de contraseña / verificación) ---
# EMAIL_BACKEND=smtp | disabled. Con "disabled" no se envían correos (los enlaces no llegan).
EMAIL_BACKEND=disabled
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_SSL=false
EMAIL_FROM=EcoMove Querétaro <no-reply@example.com>
# URL pública del sitio, usada en los enlaces de los correos.
WEB_URL=https://example.com

# --- Geocodificación (Nominatim público: máx. 1 petición/s; identifica tu servicio) ---
GEOCODING_ENABLED=true
GEOCODING_USER_AGENT=EcoMoveQueretaro/1.0 (contacto: admin@example.com)

# --- Primer SUPER_ADMIN (solo se crea si no existe ninguno; contraseña >= 12 caracteres) ---
# Rellénalo para el primer arranque y BÓRRALO después (docs/deployment/DEPLOYMENT_GUIDE.md §19).
BOOTSTRAP_SUPER_ADMIN_EMAIL=
BOOTSTRAP_SUPER_ADMIN_PASSWORD=

# --- Web (se incrustan en la imagen al construirla: cambiar = reconstruir) ---
NEXT_PUBLIC_API_BASE_URL=https://api.example.com/api/v1
NEXT_PUBLIC_SITE_URL=https://example.com

# --- Puertos locales (solo 127.0.0.1; Nginx del host los usa como upstream) ---
API_HOST_PORT=8000
WEB_HOST_PORT=3000

# --- Backups (infrastructure/scripts/backup.sh) ---
BACKUP_DIR=/var/backups/ecomove
BACKUP_RETENTION_DAYS=14
# Copia externa opcional con rclone (docs/deployment/BACKUPS_AND_RESTORE.md). Vacío = desactivado.
BACKUP_RCLONE_REMOTE=
