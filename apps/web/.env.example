# Variables del sitio web (apps/web). Copia a apps/web/.env.local. Sin secretos.

# URL pública de la API. El navegador la llama directo con el access token en memoria (ADR-003).
# NEXT_PUBLIC_* termina en el bundle del navegador: NUNCA pongas secretos en variables NEXT_PUBLIC_.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# URL de la API desde el servidor de Next (BFF /api/session/* y estadísticas públicas de la landing).
# En Docker suele ser el nombre del servicio, p. ej. http://api:8000/api/v1. Si falta, usa la pública.
API_INTERNAL_BASE_URL=http://localhost:8000/api/v1

# URL pública del sitio (canonical, sitemap, Open Graph). No es secreta.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
