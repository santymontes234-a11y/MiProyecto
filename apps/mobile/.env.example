# URL de la API. Emulador Android: 10.0.2.2 apunta al localhost del host.
# Dispositivo físico: usa la IP LAN de tu máquina (p. ej. http://192.168.1.50:8000/api/v1).
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000/api/v1
# Tiles (O1): CARTO Voyager claro y Dark Matter oscuro, datos OSM. Cambiar por servidor propio antes de producción.
EXPO_PUBLIC_TILE_URL=https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png
EXPO_PUBLIC_TILE_URL_DARK=https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png
