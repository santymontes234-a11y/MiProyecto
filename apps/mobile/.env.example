# URL de la API. Emulador Android: 10.0.2.2 apunta al localhost del host.
# Dispositivo físico: usa la IP LAN de tu máquina (p. ej. http://192.168.1.50:8000/api/v1).
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000/api/v1
# Tiles del mapa (O1). Con clave: Stadia Alidade Smooth (claro/oscuro). Vacía: tile.openstreetmap.org.
# No versionar la clave: ponla solo en apps/mobile/.env o como variable de EAS.
EXPO_PUBLIC_STADIA_API_KEY=
