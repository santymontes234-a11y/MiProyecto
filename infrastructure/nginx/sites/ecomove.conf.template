# EcoMove Querétaro — sitios de producción (generado por configure_nginx.sh; no editar en el VPS,
# edita la plantilla infrastructure/nginx/sites/ecomove.conf.template y vuelve a generar).
#   __DOMAIN__      → sitio web (Next.js, contenedor web en 127.0.0.1:__WEB_PORT__)
#   __API_DOMAIN__  → API (FastAPI, contenedor api en 127.0.0.1:__API_PORT__)
# Certificado: uno solo con los tres nombres (certbot --cert-name __DOMAIN__).
# Sintaxis compatible con Nginx 1.24 (Ubuntu 24.04): "listen ... ssl http2". En Nginx >= 1.25 emite un
# aviso de obsolescencia inofensivo; puedes cambiarlo por "http2 on;".

upstream ecomove_web {
    server 127.0.0.1:__WEB_PORT__;
    keepalive 16;
}

upstream ecomove_api {
    server 127.0.0.1:__API_PORT__;
    keepalive 16;
}

# --- Peticiones con Host desconocido (escáneres por IP): se cierran sin respuesta ---
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    include snippets/ecomove-acme.conf;
    location / { return 444; }
}

server {
    listen 443 ssl http2 default_server;
    listen [::]:443 ssl http2 default_server;
    server_name _;
    ssl_reject_handshake on;
}

# --- HTTP → HTTPS (manteniendo el desafío ACME para renovaciones) ---
server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__ www.__DOMAIN__ __API_DOMAIN__;
    include snippets/ecomove-acme.conf;
    location / {
        return 301 https://$host$request_uri;
    }
}

# --- www → dominio principal ---
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name www.__DOMAIN__;
    ssl_certificate     /etc/letsencrypt/live/__DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__DOMAIN__/privkey.pem;
    include snippets/ecomove-ssl.conf;
    include snippets/ecomove-security-headers.conf;
    return 301 https://__DOMAIN__$request_uri;
}

# --- Sitio web ---
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name __DOMAIN__;

    ssl_certificate     /etc/letsencrypt/live/__DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__DOMAIN__/privkey.pem;
    include snippets/ecomove-ssl.conf;
    include snippets/ecomove-security-headers.conf;

    access_log /var/log/nginx/ecomove-web.access.log ecomove;
    error_log  /var/log/nginx/ecomove-web.error.log warn;

    limit_conn ecomove_conn 40;
    client_max_body_size 1m;

    # Archivos ocultos (.git, .env...) nunca se sirven.
    location ~ /\.(?!well-known) { return 404; }

    # Recursos estáticos con hash: Next ya envía Cache-Control immutable.
    location /_next/static/ {
        include snippets/ecomove-proxy.conf;
        proxy_pass http://ecomove_web;
    }

    # BFF de sesión (login/refresh por cookie HttpOnly): límite estricto por IP.
    location /api/session/ {
        limit_req zone=ecomove_auth burst=20 nodelay;
        include snippets/ecomove-proxy.conf;
        proxy_pass http://ecomove_web;
    }

    location / {
        limit_req zone=ecomove_web burst=60 nodelay;
        include snippets/ecomove-proxy.conf;
        proxy_pass http://ecomove_web;
    }
}

# --- API ---
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name __API_DOMAIN__;

    ssl_certificate     /etc/letsencrypt/live/__DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__DOMAIN__/privkey.pem;
    include snippets/ecomove-ssl.conf;
    include snippets/ecomove-security-headers.conf;

    access_log /var/log/nginx/ecomove-api.access.log ecomove;
    error_log  /var/log/nginx/ecomove-api.error.log warn;

    limit_conn ecomove_conn 30;
    client_max_body_size 1m;

    location ~ /\.(?!well-known) { return 404; }

    # Solo existe /api/v1/*; el resto responde 404 sin llegar a la API.
    location = / { return 404; }

    # Autenticación: además del límite de la API (10/min por IP) se frena aquí.
    location ~ ^/api/v1/auth/(login|register|password-reset|email-verification) {
        limit_req zone=ecomove_auth burst=20 nodelay;
        include snippets/ecomove-proxy.conf;
        proxy_pass http://ecomove_api;
    }

    # Panel de administración: informes pueden tardar más (hasta 100 000 filas).
    location /api/v1/admin/ {
        limit_req zone=ecomove_api burst=30 nodelay;
        include snippets/ecomove-proxy.conf;
        proxy_read_timeout 180s;
        proxy_pass http://ecomove_api;
    }

    location /api/ {
        limit_req zone=ecomove_api burst=40 nodelay;
        include snippets/ecomove-proxy.conf;
        proxy_pass http://ecomove_api;
    }

    location / { return 404; }
}
