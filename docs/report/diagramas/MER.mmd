erDiagram
    achievements {
        uuid id PK
        varchar_40 code UK
        varchar_80 name
        varchar_300 description
        varchar_40 icon
        achievement_criterion criterion
        float8 threshold
        int4 bonus_points
        bool is_active
        timestamptz created_at
        timestamptz updated_at
    }
    audit_logs {
        uuid id PK
        uuid actor_id FK
        varchar_64 action
        varchar_32 entity_type
        uuid entity_id
        jsonb payload
        timestamptz created_at
    }
    bike_stations {
        uuid poi_id PK,FK
        poi_category category FK
        varchar_32 code UK
        int4 capacity
    }
    citizen_reports {
        uuid id PK
        uuid reporter_id FK
        citizen_report_category category
        citizen_report_status status
        varchar_120 title
        text description
        geometry_Point_4326 location
        uuid poi_id FK
        varchar_1000 resolution_note
        timestamptz created_at
        timestamptz updated_at
    }
    cycleways {
        uuid id PK
        varchar_160 name
        bool is_protected
        bigint osm_id UK
        geometry_LineString_4326 geom
        timestamptz created_at
    }
    emission_factors {
        transport_mode mode PK,FK
        float8 grams_per_km
        timestamptz valid_from
        uuid updated_by FK
    }
    notifications {
        uuid id PK
        uuid user_id FK
        notification_type type
        varchar_120 title
        varchar_500 body
        jsonb data
        timestamptz read_at
        timestamptz created_at
    }
    permissions {
        varchar_64 code PK
        varchar_255 description
    }
    pois {
        uuid id PK,UK
        varchar_160 name
        poi_category category UK
        text description
        jsonb attributes
        geometry_Point_4326 location
        bool is_active
        timestamptz created_at
        timestamptz updated_at
    }
    refresh_tokens {
        uuid id PK
        uuid user_id FK
        uuid family_id
        char_64 token_hash UK
        timestamptz expires_at
        timestamptz revoked_at
        uuid replaced_by_id
        timestamptz created_at
        timestamptz session_created_at
        timestamptz last_used_at
        varchar_255 user_agent
    }
    reports {
        uuid id PK
        report_type report_type
        report_format format
        jsonb parameters
        int4 row_count
        bytea content
        uuid created_by FK
        timestamptz created_at
    }
    role_permissions {
        user_role role PK,FK
        varchar_64 permission_code PK,FK
    }
    roles {
        user_role name PK
        varchar_255 description
        int2 level
    }
    stop_lines {
        uuid stop_id PK,FK
        uuid line_id PK,FK
    }
    transit_lines {
        uuid id PK
        varchar_32 code UK
        varchar_120 name
        timestamptz created_at
    }
    transit_stops {
        uuid poi_id PK,FK
        poi_category category FK
        varchar_32 code UK
        varchar_64 osm_ref
    }
    transport_modes {
        transport_mode mode PK
        float8 max_speed_kmh
        bool is_active
    }
    trips {
        uuid id PK
        uuid user_id FK,UK
        uuid client_trip_id UK
        transport_mode mode FK
        trip_status status
        timestamptz started_at
        timestamptz ended_at
        float8 distance_m
        int4 duration_s
        geometry_LineString_4326 route
        float8 emission_factor_g_per_km
        float8 co2_emitted_g
        float8 co2_saved_g
        timestamptz created_at
        trip_source source
        int4 points
        uuid recurrence_id
        timestamptz updated_at
        vehicle_type vehicle_type FK
        int2 occupants
    }
    user_achievements {
        uuid id PK
        uuid user_id FK,UK
        uuid achievement_id FK,UK
        int4 bonus_points
        timestamptz awarded_at
    }
    user_preferences {
        uuid user_id PK,FK
        varchar_2 language
        transport_mode default_mode FK
        int2 weekly_goal_trips
        bool email_notifications
        timestamptz updated_at
        vehicle_type default_vehicle_type FK
    }
    user_tokens {
        uuid id PK
        uuid user_id FK
        token_purpose purpose
        char_64 token_hash UK
        timestamptz expires_at
        timestamptz used_at
        timestamptz created_at
    }
    users {
        uuid id PK
        varchar_254 email UK
        varchar_255 password_hash
        varchar_120 full_name
        user_role role FK
        bool is_active
        int4 failed_login_attempts
        timestamptz locked_until
        timestamptz last_login_at
        timestamptz created_at
        timestamptz updated_at
        timestamptz email_verified_at
        bool ranking_opt_in
        int4 token_version
    }
    vehicle_types {
        vehicle_type code PK
        float8 grams_per_km
        int2 max_occupants
        bool is_active
        varchar_300 source
        timestamptz updated_at
    }
    geo_mobility_zones {
        uuid id PK
        text code UK
        text name
        text kind
        geometry_MultiPolygon_4326 geom
        geometry_MultiPolygon_32614 geom_utm
        float8 area_km2
        text source
        bool is_demo
        timestamptz created_at
    }
    geo_zone_census {
        text zone_code PK,FK
        text source PK
        int4 pobtot
        int4 tvivparhab
        int4 vph_autom
        int4 vph_moto
        int4 vph_bici
    }
    users ||--o{ audit_logs : "actor_id"
    pois ||--o| bike_stations : "poi_id"
    pois ||--o{ bike_stations : "category"
    users ||--o{ citizen_reports : "reporter_id"
    pois ||--o{ citizen_reports : "poi_id"
    transport_modes ||--o| emission_factors : "mode"
    users ||--o{ emission_factors : "updated_by"
    users ||--o{ notifications : "user_id"
    users ||--o{ refresh_tokens : "user_id"
    users ||--o{ reports : "created_by"
    roles ||--o{ role_permissions : "role"
    permissions ||--o{ role_permissions : "permission_code"
    transit_stops ||--o{ stop_lines : "stop_id"
    transit_lines ||--o{ stop_lines : "line_id"
    pois ||--o| transit_stops : "poi_id"
    pois ||--o{ transit_stops : "category"
    users ||--o{ trips : "user_id"
    transport_modes ||--o{ trips : "mode"
    vehicle_types ||--o{ trips : "vehicle_type"
    users ||--o{ user_achievements : "user_id"
    achievements ||--o{ user_achievements : "achievement_id"
    users ||--o| user_preferences : "user_id"
    transport_modes ||--o{ user_preferences : "default_mode"
    vehicle_types ||--o{ user_preferences : "default_vehicle_type"
    users ||--o{ user_tokens : "user_id"
    roles ||--o{ users : "role"
    geo_mobility_zones ||--o{ geo_zone_census : "zone_code"
